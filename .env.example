# ───────────────────────────────────────────────
# Crayon2Couture / AnStationery — Environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env to git.
# ───────────────────────────────────────────────

# ── SUPABASE (database + storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# ── Admin credentials ──
ADMIN_EMAIL=Anstationery2@gmail.com
ADMIN_PASSWORD=ANstationery@123

# ── JWT secret (change to a long random string) ──
AUTH_SECRET=anstationery-jwt-secret-change-me-2026

# ── Google OAuth (get from Google Cloud Console > Credentials) ──
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ── App / OAuth redirect base URL ──
# The Google OAuth callback is built from this: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Local dev uses http://localhost:3000 ; production uses the real domain.
NEXT_PUBLIC_APP_URL=https://anstationery.in

# ── Razorpay Payment Gateway ──
# Get your test/live keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# ── Optional: keep for local SQLite fallback ──
DATABASE_URL="file:./dev.db"
